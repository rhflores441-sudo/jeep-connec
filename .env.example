# ---------------------------------------------------------------------------
# JEEP CONNECT · variables públicas de entorno
# Copia este archivo como `.env` y completa los valores.
# Las variables EXPO_PUBLIC_* se incluyen en el bundle: NUNCA pongas secretos.
# ---------------------------------------------------------------------------

# Spotify Web API (https://developer.spotify.com/dashboard)
# 1. Crea una app en el dashboard y copia el Client ID (PKCE no usa secreto).
# 2. Registra exactamente la misma Redirect URI que pongas aquí.
# 3. Spotify solo admite https:// o loopback http://127.0.0.1 / http://[::1];
#    para móvil necesitas un pequeño proxy HTTPS (ver docs/SPOTIFY.md).
# Opcional: si lo dejas vacío, la app pedirá el Client ID en Ajustes → Spotify.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=
# Proxy HTTPS opcional: recibe /callback de Spotify y redirige a jeepconnect://spotify-callback
EXPO_PUBLIC_SPOTIFY_AUTH_PROXY_URL=

# Opcionales: endpoints alternativos de datos abiertos.
# Por defecto se usan CARTO/OSM para teselas, OSRM para rutas y Nominatim para búsqueda.
EXPO_PUBLIC_TILE_URL_DARK=https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
EXPO_PUBLIC_TILE_URL_LIGHT=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org
EXPO_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
EXPO_PUBLIC_RADIO_API_URL=https://de1.api.radio-browser.info
